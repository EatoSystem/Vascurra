# Local `next dev` defaults to fixture mode without any environment file.
# Leave unset for automatic local fixture / production connected selection.
# VASCURRA_MODE=fixture
# Production, Vercel and CI never allow development fixture identity.
SUPABASE_ENABLED=false
REAL_AUTH_ENABLED=false
# Live AI, payments and personal data are hard-disabled in the capability policy.
# These are not activation switches in this release.
# Connected staff console requires all three flags plus URL/publishable key.
VEYAI_CONSOLE_ENABLED=false
VEYAI_EXECUTION_MODE=disabled
VEYAI_APP_ORIGIN=http://localhost:3100
VEYAI_SUPABASE_URL=
VEYAI_SUPABASE_PUBLISHABLE_KEY=
# Dedicated worker login granted only the veyai_worker role; never use postgres
# or a Supabase service-role key for normal web/worker traffic.
VEYAI_WORKER_DATABASE_URL=
VEYAI_LOCAL_DATABASE=false
# No OPENAI_API_KEY is required or consumed by this fixture-first release.

# Stripe-hosted Checkout remains disconnected until the activation gates in
# STRIPE_INTEGRATION_TODO.md have been completed and explicitly approved.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_SITE_URL=http://localhost:3100
